-- Helper Function: Check Team
local function IsTeammate(player)
    if not player then return false end
    if player.Team ~= nil and LocalPlayer.Team ~= nil then
        return player.Team == LocalPlayer.Team
    end
    if player.TeamColor ~= nil and LocalPlayer.TeamColor ~= nil then
        return player.TeamColor == LocalPlayer.TeamColor
    end
    return false
end

-- Helper Function: Check Wall/Line of Sight (สำหรับ Aimbot)
local function IsVisible(targetPart)
    if not targetPart or not targetPart:IsA("BasePart") then return false end
    
    local raycastParams = RaycastParams.new()
    raycastParams.FilterType = RaycastFilterType.Exclude
    
    local filterList = {Camera}
    if LocalPlayer.Character then
        table.insert(filterList, LocalPlayer.Character)
    end
    raycastParams.FilterDescendantsInstances = filterList
    
    local origin = Camera.CFrame.Position
    local destination = targetPart.Position
    local direction = destination - origin
    
    local rayResult = workspace:Raycast(origin, direction, raycastParams)
    if rayResult then
        return rayResult.Instance:IsDescendantOf(targetPart.Parent)
    end
    return true
end

local function GetClosestPlayerToCenter()
    local Closest = nil
    local MaxDistance = Settings.FOV.Enabled and Settings.FOV.Radius or math.huge
    local CenterPos = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)

    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            if Settings.Aimbot.TeamCheck and IsTeammate(player) then
                continue
            end
            
            local char = player.Character
            if char then
                local targetPartName = Settings.Aimbot.TargetPart
                if targetPartName == "Torso" then
                    targetPartName = char:FindFirstChild("Torso") and "Torso" or "UpperTorso"
                end
                
                local TargetPart = char:FindFirstChild(targetPartName) or char:FindFirstChild("HumanoidRootPart")
                if TargetPart then
                    local humanoid = char:FindFirstChildOfClass("Humanoid")
                    if humanoid and humanoid.Health > 0 then
                        local ScreenPos, OnScreen = Camera:WorldToViewportPoint(TargetPart.Position)

                        if OnScreen then
                            -- Wall Check จะทำงานเฉพาะการจับเป้าของ Aimbot เท่านั้น
                            if Settings.Aimbot.WallCheck and not IsVisible(TargetPart) then
                                continue
                            end
                            
                            local Distance = (Vector2.new(ScreenPos.X, ScreenPos.Y) - CenterPos).Magnitude
                            if Distance < MaxDistance then
                                MaxDistance = Distance
                                Closest = TargetPart
                            end
                        end
                    end
                end
            end
        end
    end
    return Closest
end

local function CreateESP(player)
    if ESPObjects[player] then return end
    local objects = {
        Box = Drawing.new("Square"), BoxOutline = Drawing.new("Square"),
        BoxCorners = {}, HealthBarBG = Drawing.new("Square"),
        HealthBar = Drawing.new("Square"), Name = Drawing.new("Text"),
        Distance = Drawing.new("Text"), Line = Drawing.new("Line"),
        Highlight = Instance.new("Highlight") -- Instance สำหรับ Highlight
    }
    
    -- Highlight Setup
    objects.Highlight.Name = "ESPHighlight_" .. player.Name
    objects.Highlight.FillColor = Settings.ESP.Color
    objects.Highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
    objects.Highlight.FillTransparency = 0.5
    objects.Highlight.OutlineTransparency = 0
    objects.Highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    objects.Highlight.Enabled = false

    for i = 1, 8 do
        local line = Drawing.new("Line")
        line.Thickness = 1.2
        line.Color = Settings.ESP.Color
        line.Visible = false
        table.insert(objects.BoxCorners, line)
    end
    objects.Box.Thickness = 1.2
    objects.Box.Filled = false
    objects.Box.Color = Settings.ESP.Color

    objects.BoxOutline.Thickness = 2.5
    objects.BoxOutline.Filled = false
    objects.BoxOutline.Color = Color3.fromRGB(0, 0, 0)

    objects.HealthBarBG.Filled = true
    objects.HealthBarBG.Color = Color3.fromRGB(20, 20, 20)

    objects.HealthBar.Filled = true
    objects.HealthBar.Color = Color3.fromRGB(46, 204, 113)

    objects.Name.Size = 13
    objects.Name.Center = true
    objects.Name.Outline = true
    objects.Name.Color = Color3.fromRGB(255, 255, 255)

    objects.Distance.Size = 11
    objects.Distance.Center = true
    objects.Distance.Outline = true
    objects.Distance.Color = Color3.fromRGB(180, 180, 180)

    objects.Line.Thickness = 1.2
    objects.Line.Color = Settings.ESP.Color

    ESPObjects[player] = objects
end

local function RemoveESP(player)
    if ESPObjects[player] then
        for _, obj in pairs(ESPObjects[player]) do
            if type(obj) == "table" then
                for _, line in pairs(obj) do line:Remove() end
            elseif typeof(obj) == "Instance" then
                obj:Destroy()
            else
                obj:Remove()
            end
        end
        ESPObjects[player] = nil
    end
end

-- Render Loop
RunService.RenderStepped:Connect(function()
    MinimalCenterFOV.Position = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)

    if Settings.Aimbot.Enabled then
        local Target = GetClosestPlayerToCenter()
        if Target then
            local TargetCFrame = CFrame.new(Camera.CFrame.Position, Target.Position)
            Camera.CFrame = Camera.CFrame:Lerp(TargetCFrame, Settings.Aimbot.Smoothness)
        end
    end

    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            CreateESP(player)
            local esp = ESPObjects[player]
            local char = player.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            local hum = char and char:FindFirstChildOfClass("Humanoid")

            local isTeammate = Settings.ESP.TeamCheck and IsTeammate(player)

            if char and hrp and hum and hum.Health > 0 and not isTeammate then
                -- จัดการ Highlight ESP (ทำงานได้แม้ว่าจะอยู่หลังกำแพง)
                if Settings.ESP.Highlight then
                    esp.Highlight.Adornee = char
                    esp.Highlight.Parent = char
                    esp.Highlight.Enabled = true
                else
                    esp.Highlight.Enabled = false
                end

                local Pos, OnScreen = Camera:WorldToViewportPoint(hrp.Position)
                if OnScreen then
                    local Head = char:FindFirstChild("Head")
                    local HeadPos = Head and Camera:WorldToViewportPoint(Head.Position + Vector3.new(0, 0.5, 0)) or Pos
                    local LegPos = Camera:WorldToViewportPoint(hrp.Position - Vector3.new(0, 3, 0))
                    local Height = math.abs(HeadPos.Y - LegPos.Y)
                    local Width = Height / 1.6

                    if Settings.ESP.Box then
                        if Settings.ESP.BoxStyle == "2D" then
                            esp.Box.Size = Vector2.new(Width, Height)
                            esp.Box.Position = Vector2.new(Pos.X - Width / 2, Pos.Y - Height / 2)
                            esp.Box.Visible = true
                            esp.BoxOutline.Size = Vector2.new(Width, Height)
                            esp.BoxOutline.Position = Vector2.new(Pos.X - Width / 2, Pos.Y - Height / 2)
                            esp.BoxOutline.Visible = true
                            for _, line in pairs(esp.BoxCorners) do line.Visible = false end
                        elseif Settings.ESP.BoxStyle == "Corner" then
                            esp.Box.Visible = false
                            esp.BoxOutline.Visible = false
                            local X, Y = Pos.X - Width / 2, Pos.Y - Height / 2
                            local cWidth, cHeight = Width / 4, Height / 4
                            local corners = esp.BoxCorners
                            corners[1].From, corners[1].To = Vector2.new(X, Y), Vector2.new(X + cWidth, Y)
                            corners[2].From, corners[2].To = Vector2.new(X, Y), Vector2.new(X, Y + cHeight)
                            corners[3].From, corners[3].To = Vector2.new(X + Width, Y), Vector2.new(X + Width - cWidth, Y)
                            corners[4].From, corners[4].To = Vector2.new(X + Width, Y), Vector2.new(X + Width, Y + cHeight)
                            corners[5].From, corners[5].To = Vector2.new(X, Y + Height), Vector2.new(X + cWidth, Y + Height)
                            corners[6].From, corners[6].To = Vector2.new(X, Y + Height), Vector2.new(X, Y + Height - cHeight)
                            corners[7].From, corners[7].To = Vector2.new(X + Width, Y + Height), Vector2.new(X + Width - cWidth, Y + Height)
                            corners[8].From, corners[8].To = Vector2.new(X + Width, Y + Height), Vector2.new(X + Width, Y + Height - cHeight)
                            for _, line in pairs(corners) do line.Visible = true end
                        end
                    else
                        esp.Box.Visible = false
                        esp.BoxOutline.Visible = false
                        for _, line in pairs(esp.BoxCorners) do line.Visible = false end
                    end

                    if Settings.ESP.HealthBar then
                        local HealthPercent = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
                        esp.HealthBarBG.Size = Vector2.new(4, Height)
                        esp.HealthBarBG.Position = Vector2.new(Pos.X - Width / 2 - 8, Pos.Y - Height / 2)
                        esp.HealthBarBG.Visible = true
                        esp.HealthBar.Size = Vector2.new(2, Height * HealthPercent)
                        esp.HealthBar.Position = Vector2.new(Pos.X - Width / 2 - 7, Pos.Y + Height / 2 - (Height * HealthPercent))
                        esp.HealthBar.Visible = true
                    else
                        esp.HealthBarBG.Visible = false
                        esp.HealthBar.Visible = false
                    end

                    if Settings.ESP.Name then
                        esp.Name.Text = player.Name
                        esp.Name.Position = Vector2.new(Pos.X, Pos.Y - Height / 2 - 16)
                        esp.Name.Visible = true
                    else
                        esp.Name.Visible = false
                    end

                    if Settings.ESP.Distance then
                        local myChar = LocalPlayer.Character
                        local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")
                        if myHRP then
                            local dist = math.floor((myHRP.Position - hrp.Position).Magnitude)
                            esp.Distance.Text = "[" .. tostring(dist) .. "m]"
                            esp.Distance.Position = Vector2.new(Pos.X, Pos.Y + Height / 2 + 4)
                            esp.Distance.Visible = true
                        else
                            esp.Distance.Visible = false
                        end
                    else
                        esp.Distance.Visible = false
                    end

                    if Settings.ESP.Line then
                        local originY = Camera.ViewportSize.Y
                        if Settings.ESP.LineOrigin == "Top" then originY = 0
                        elseif Settings.ESP.LineOrigin == "Middle" then originY = Camera.ViewportSize.Y / 2 end
                        esp.Line.From = Vector2.new(Camera.ViewportSize.X / 2, originY)
                        esp.Line.To = Vector2.new(Pos.X, Pos.Y)
                        esp.Line.Visible = true
                    else
                        esp.Line.Visible = false
                    end
                else
                    esp.Box.Visible = false
                    esp.BoxOutline.Visible = false
                    for _, line in pairs(esp.BoxCorners) do line.Visible = false end
                    esp.HealthBarBG.Visible = false
                    esp.HealthBar.Visible = false
                    esp.Name.Visible = false
                    esp.Distance.Visible = false
                    esp.Line.Visible = false
                end
            else
                esp.Highlight.Enabled = false
                esp.Box.Visible = false
                esp.BoxOutline.Visible = false
                for _, line in pairs(esp.BoxCorners) do line.Visible = false end
                esp.HealthBarBG.Visible = false
                esp.HealthBar.Visible = false
                esp.Name.Visible = false
                esp.Distance.Visible = false
                esp.Line.Visible = false
            end
        end
    end
end)

Players.PlayerRemoving:Connect(RemoveESP)

